# .env.example — шаблон
# На сервере скопировать в .env и заполнить реальными значениями
# Файл .env НИКОГДА не пушить в git и не класть в образ!

BITBUCKET_URL=http://bitbucket.bank.ru
BITBUCKET_TOKEN=токен_

FENIX_URL=http://fenix.bank.ru/api/chat
FENIX_TOKEN=токен_
FENIX_MODEL=DeepSeek V3.2

# Максимум строк диффа НА ОДИН ФАЙЛ за запрос к Фениксу.
# ВНИМАНИЕ: семантика — на файл, а не на весь PR (бот ревьюит файлы по одному,
# REV-001). Уменьши если выбиваешь лимит токенов; подними если файлы крупные.
MAX_DIFF_LINES=400

# ── Параметры обращения к Фениксу (все опциональны — есть дефолты в коде) ──
# Можно вообще не задавать: бот возьмёт значения по умолчанию (указаны справа).
# Крутить эти переменные = менять поведение БЕЗ пересборки образа (только перезапуск).

# Лимит длины ответа модели. 4096 хватает на ревью (≤10 коротких замечаний).
# Меньше = быстрее и экономнее по лимиту ~700k ток/мин. Если в логах увидишь
# finish_reason=length (ответ обрезан) — подними.
FENIX_MAX_TOKENS=4096

# Таймаут запроса к Фениксу, секунды. На webhook НЕ влияет: бот отвечает Bitbucket
# 200 сразу, ревью идёт в фоне. Поднимай, если на пике не успевает сгенериться.
FENIX_TIMEOUT=90

# Сколько ревью обращаются к Фениксу одновременно. 1 = строго по очереди —
# защита от спайков по лимиту 700k ток/мин, когда PR прилетают пачкой.
FENIX_MAX_CONCURRENCY=1

# Повторы запроса при таймауте/429 (с backoff). 0 = выключить.
# Помогает в основном при 429 (лимит поминутный); от устойчивого пика не лечит.
FENIX_MAX_RETRIES=1

# ── Inspector: perlcritic через mcp-drospr (spec 004) ──────────────────────────
# Детерминированный слой [perlcritic]. Бот вызывает соседний сервис mcp-drospr,
# perlcritic В БОТ НЕ встроен (Вариант B, ARCHITECTURE.md §2.10).
#
# Базовый URL mcp-drospr. ПУСТО → слой выключен (бот = чистый Феникс, как раньше).
MCP_DROSPR_URL=
# Таймаут вызова mcp-drospr, секунды.
MCP_TIMEOUT=20
# Kill switch слоя: 1 = включить perlcritic, 0 = выключить (мгновенный откат через .env+рестарт).
# На демо/после приёмки = 1. Требует заданного MCP_DROSPR_URL.
PERLCRITIC_ENABLED=0
# Фильтр строгости perlcritic. ВНИМАНИЕ: шкала ИНВЕРТИРОВАНА — 1=ВСЕ нарушения,
# 5=только критические. Пилот = 5 (минимум шума), смягчать позже.
PERLCRITIC_SEVERITY=5
# Пороги маппинга severity perlcritic → уровни бота (severity≥ERROR_MIN → error и т.д.).
PERLCRITIC_SEVERITY_ERROR_MIN=4
PERLCRITIC_SEVERITY_WARNING_MIN=2
# Лимит [perlcritic]-комментариев на PR (не затопить ревью). Сверх — упомянуто в сводке.
PERLCRITIC_MAX_COMMENTS=10

# ── Inspector: детерминированный styleguide-grep (метка [codestyle]) ───────────
# Правила команды (regex) в примонтированном файле. Правится заменой файла на VM
# без ребилда. Формат строки:  severity | regex | message
STYLEGUIDE_RULES_PATH=/app/styleguide_rules.txt
# 1 = включить слой [codestyle], 0 = выключить.
STYLEGUIDE_RULES_ENABLED=1

# ── Прозовый стайлгайд для Феникса (уходит в промпт блоком «STYLEGUIDE») ────────
# Дефолт — ./styleguide.md рядом с ботом: работает и при запуске скриптом (банковская
# VM без Docker), и в контейнере (WORKDIR /app). Задавать только если файл в другом месте.
#STYLEGUIDE_PATH=./styleguide.md

# ── WIP-гейт: ревью запускается, когда автор снял метку черновика (spec 010) ────
# «Готов к ревью» = снятая метка в ЗАГОЛОВКЕ PR, а не отдельная кнопка. Пока в
# начале заголовка стоит маркер (по умолчанию WIP), бот молчит; снятие маркера —
# правка заголовка (событие pr:modified) — запускает ревью всего PR целиком.
#
# Kill switch: 1 = гейт включён (дефолт, opt-out), 0 = ревьюить всё как раньше.
WIP_GATING_ENABLED=1
# Маркеры черновика через запятую, регистр не важен. По умолчанию только WIP;
# можно расширить, напр.: WIP,draft,черновик. Совпадение по началу заголовка и
# границе слова (заголовок вида "Wiper module" черновиком НЕ считается).
WIP_MARKERS=WIP
# 1 = разово написать в PR-черновик «жду снятия метки» (идемпотентно), 0 = молча.
WIP_NOTIFY_ENABLED=1

# ── Impact-анализ: граф вызовов через mcp-drospr get_callers (FR-009) ──────────
# Детерминированный слой [impact]: «что сломается, если переименовать функцию».
# Требует MCP_DROSPR_URL (БЕЗ /sse) и загруженного индекса в mcp (POST /index/upload),
# иначе get_callers не зарегистрирован → импакт молча выключается с пометкой в ревью.
# 1 = включить (на демо/проде = 1), 0 = выключить.
IMPACT_ENABLED=0
# Макс. число изменённых функций НА ФАЙЛ, по которым спрашиваем callers (защита от шума).
IMPACT_MAX_SYMBOLS=20

# ── Контекст ревью: ханки или полный файл (spec 011) ──────────────────────────
# hunks (дефолт) — в промпт уходят только куски diff'а, как в проде сегодня.
# file            — уходит ПОЛНЫЙ текст файла, изменённые строки помечены `+`:
#                   модель видит прагмы, объявления и валидацию выше по коду.
# Стоит токенов, поэтому включается осознанно. На время эксперимента режим
# удобнее задавать флагом review_cli.py --context-mode, а не здесь.
REVIEW_CONTEXT_MODE=hunks
# Потолок размера файла для режима file, в СИМВОЛАХ (не в строках: строки бывают
# разной плотности, а ограничение реальное — бюджет токенов). Файл больше потолка
# ревьюится ханками, факт пишется в лог и в отчёт прогона.
REVIEW_FILE_MAX_CHARS=120000

# ── Фильтр замечаний модели по изменённым строкам (spec 011) ──────────────────
# 1 (дефолт) = не публиковать замечание, если его строку этот PR не менял.
# Промпт и раньше просил комментировать только строки с `+`, но просьба — не
# гарантия. Замечание с нераспознанным номером НЕ теряется: уходит общим
# комментарием, как и сегодня.
LLM_LINE_FILTER_ENABLED=1

# ── Dry-run: прогон без записи в PR (spec 011) ────────────────────────────────
# ⚠️ НА ПРОДЕ ДОЛЖЕН БЫТЬ ВЫКЛЮЧЕН. При JARVIS_DRY_RUN=1 бот работает как обычно,
# но НЕ публикует комментарии — снаружи это выглядит как «бот молчит». Текущее
# состояние видно в логе при старте и в ответе /health (поле dry_run).
JARVIS_DRY_RUN=0
# Папка для JSONL-отчётов dry-run. Дефолта НЕТ сознательно: без явного пути отчёт
# лёг бы в текущую директорию — а это клон репозитория, откуда содержимое может
# уехать в git. Только АБСОЛЮТНЫЙ путь ВНЕ клона, например ~/jarvis_experiment/A.
#JARVIS_DRY_RUN_DIR=
